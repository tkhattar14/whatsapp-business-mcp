# WhatsApp MCP Server - Environment Variables
# Copy this file to .env and fill in your values.
# Get credentials from: https://developers.facebook.com/

# === REQUIRED ===
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here

# === RECOMMENDED ===
META_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WABA_ID=your_waba_id_here
META_APP_ID=your_app_id_here

# === OPTIONAL ===
META_BUSINESS_PORTFOLIO_ID=your_portfolio_id_here
WHATSAPP_API_VERSION=v22.0

# === SECURITY (for HTTP server mode) ===
# App secret for verifying webhook signatures (X-Hub-Signature-256)
META_APP_SECRET=your_app_secret_here

# API key for authenticating HTTP API requests (X-API-Key header)
# If not set, API key auth is disabled (dev mode)
MCP_API_KEY=

# Comma-separated list of allowed CORS origins (e.g., https://example.com,https://app.example.com)
# If not set, CORS is disabled (no cross-origin requests allowed)
ALLOWED_ORIGINS=

# Directory where media uploads are allowed from (path traversal protection)
MEDIA_UPLOAD_DIR=/tmp/whatsapp-media/

# HTTP server port (default: 8080)
PORT=8080
# Address to listen on (default: 0.0.0.0). Use 127.0.0.1 behind a reverse proxy on the same machine
# (the systemd service in deploy/ sets this for you)
HOST=0.0.0.0

# Optional (stdio MCP mode): JSON file of contacts exposed as resource://contacts
# CONTACTS_FILE=

# === CUSTOMER SUPPORT BOT (webhook + questionnaire + agent handoff) ===
# Any random string; enter the same value as "Verify token" in Meta App Dashboard > WhatsApp > Configuration
WEBHOOK_VERIFY_TOKEN=
# Hours without an agent reply before the bot takes over a conversation again
AGENT_IDLE_HOURS=12
# Hours of customer silence after which an unfinished questionnaire starts over
GREETING_GAP_HOURS=24
# Timezone for the Date/Time column in the log (e.g. Africa/Lagos, Europe/London)
LOG_TIMEZONE=UTC
# Database (source of truth for the Excel log, tickets and agent reply links).
# Production: set DATABASE_URL to a PostgreSQL connection URL (postgresql://user:pass@host:5432/db).
# If DATABASE_URL is empty, a local SQLite file at SUPPORT_DB_PATH is used instead.
DATABASE_URL=
SUPPORT_DB_PATH=data/support.db
# Only for the one-time scripts/copy_sqlite_to_postgres.py run - the PostgreSQL URL to copy into
# MIGRATE_TO_DATABASE_URL=
# Optional: custom questionnaire file (default: support_bot/flow.json)
# SUPPORT_FLOW_FILE=

# === RELAY MODE (agent replies from their own WhatsApp) ===
# The agent's personal WhatsApp number with country code, e.g. 2348012345678.
# Leave empty if the agent uses the WhatsApp Business app on the same number (Coexistence).
AGENT_WHATSAPP_NUMBER=
# Optional: approved template that alerts the agent when forwards are waiting (24-hour rule)
AGENT_ALERT_TEMPLATE=
AGENT_ALERT_TEMPLATE_LANGUAGE=en

# === SHAREPOINT EXCEL LOG (Microsoft Graph, app-only) ===
# Leave empty to only log locally (export via /api/v1/support/export.csv)
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Either paste the file's SharePoint link ("Copy link" in SharePoint)...
SHAREPOINT_FILE_URL=
# ...or give its location:
# e.g. contoso.sharepoint.com
SHAREPOINT_HOSTNAME=
# e.g. /sites/CustomerService
SHAREPOINT_SITE_PATH=
# Path inside the site's "Documents" library, e.g. WhatsApp/Conversation Log.xlsx
SHAREPOINT_FILE_PATH=
SHAREPOINT_TABLE_NAME=Conversations
SHAREPOINT_TICKETS_TABLE=Tickets
EXCEL_SYNC_INTERVAL_SECONDS=15

# === WHATSAPP GROUP AGENT (dedicated number in residents' groups) ===
# Off by default. When true, the container also starts the WhatsApp bridge (wa_bridge/).
GROUP_AGENT_ENABLED=false
# listen  = store every message only (no LLM, never sends)
# observe = the LLM logs and tracks issues in every group, but never sends anything
# reply   = full agent; sends only in GROUP_AGENT_REPLY_CHATS and observes all other groups
GROUP_AGENT_MODE=listen
# Groups the agent may reply in: group names or ids, comma-separated ("*" = all groups)
GROUP_AGENT_REPLY_CHATS=
ASSISTANT_NAME=Max Migold Assistant
# Shared secret between the bridge and the app - any long random string
BRIDGE_SECRET=
# Where the linked WhatsApp session is kept (a login credential - keep it private)
# BRIDGE_AUTH_DIR=/data/wa_auth
# Any OpenAI-compatible chat completions API. Leave empty for test mode (replies only when addressed by name)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.3
# auto = native tool calling, switching to JSON answers if the server refuses it (e.g. vLLM
# started without --enable-auto-tool-choice) | tools | json
LLM_TOOL_MODE=auto
# Fallback model, used whenever the main one fails (e.g. the vLLM server is down). Off until
# LLM_FALLBACK_API_KEY is set; defaults to Google Gemini (key from https://aistudio.google.com/apikey).
# Note: on Gemini's free tier, Google may use the messages sent to improve its products.
LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_FALLBACK_MODEL=gemini-flash-latest
# Pacing: wait for a burst of messages to finish, and space out replies per group
GROUP_AGENT_DEBOUNCE_SECONDS=6
GROUP_AGENT_MIN_REPLY_GAP_SECONDS=60
GROUP_AGENT_HISTORY=30
# Issue follow-up: no staff response -> @mention "First contact" staff in the group after
# GROUP_REMINDER_MINUTES, then privately message "Escalate to" staff after GROUP_ESCALATE_MINUTES;
# an issue awaiting the resident's rating closes without one after GROUP_FEEDBACK_HOURS
GROUP_REMINDER_MINUTES=30
GROUP_ESCALATE_MINUTES=60
GROUP_FEEDBACK_HOURS=24
# A resident who tags a staff member: that person gets GROUP_TAG_WAIT_MINUTES to answer
# before the agent acknowledges
GROUP_TAG_WAIT_MINUTES=10
# In progress but not done after GROUP_FOLLOWUP_HOURS: private follow-up to the staff member
# who took it on, then every GROUP_FOLLOWUP_REPEAT_HOURS, at most GROUP_FOLLOWUP_MAX times
GROUP_FOLLOWUP_HOURS=48
GROUP_FOLLOWUP_REPEAT_HOURS=24
GROUP_FOLLOWUP_MAX=3
# Staff list: table in the Complaints Log workbook (needs the SHAREPOINT_ settings)
GROUP_STAFF_TABLE=Staff
